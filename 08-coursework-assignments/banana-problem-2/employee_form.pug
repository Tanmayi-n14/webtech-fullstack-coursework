html
  head
    title Employee Details Form
  body
    h2 Employee Details
    
    form(action = "/", method = "POST")
      div
        label(for = "name") Employee Name:
        input(name = "name" required=true)
      br
      div
        label(for = "emp_id") Employee ID:
        input(name = "emp_id" required=true)
      br
      div
        label(for = "dept") Department:
        input(name = "dept")
      br
      div
        label(for = "email") Email ID:
        input(type="email" name = "email")
      br
      div
        label(for = "salary") Salary:
        input(type="number" name = "salary")
      br
      button(type = "submit") Submit	